<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="720"
        x:Class="VoltageSystem.VoltageWindow"
        Width="1280"



        Title="VoltageWindow">
     <Window.Styles>
        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="#0F1B29"/>
        </Style>

        <Style Selector="TextBox:focus /template/ Border">
            <Setter Property="Background" Value="#0F1B29"/>
        </Style>

    </Window.Styles>       
    <Grid 
        Background="#223146"
        ColumnDefinitions="*,*">

        <Grid 
            Grid.Column="0"
            Background="#223146"
            RowDefinitions="*,*">

        <Grid
            Background="#223146"
            Grid.Row="0"
            RowDefinitions="*,*">

        <Label
            Grid.Row="0"
                Name="VoltageLabel"
                Content="Live Voltage"
                HorizontalContentAlignment="Center"
                Width="252"
                Height="29"
                Background="#0F1B29"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                />
        <Grid
            Background="#223146"
            Grid.Row="1"
            RowDefinitions="*,*">


        <Label
                Grid.Row="0"
                Name="CurrentVoltageLabel"
                Width="252"
                Content="Current voltage:"
                HorizontalContentAlignment="Center"
                Height="52"
                Background="#0F1B29"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                FontFamily="Sora"
                FontSize="16"
                BorderThickness="1">
            </Label>

        <Label
                Grid.Row="1"
                Name="VoltageLbl"
                Width="252"
                Content=""
                HorizontalContentAlignment="Center"
                Height="52"
                Background="#0F1B29"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                FontFamily="Sora"
                FontSize="16"
                BorderThickness="1">
            </Label>



        </Grid>

        </Grid>
        

        <StackPanel
            Orientation="Vertical"
            Grid.Row="1"
            Spacing="10"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
        <StackPanel
            Orientation="Horizontal"
            Spacing="10"
            VerticalAlignment="Center">
        <ComboBox   
                Name="PortComboBox"
                Width="141"
                Height="29"
                Background="#FF6B00"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                            />

            <Button

                Name="ConectarButton"
                Content="Connect"
                Width="141"
                Height="29"
                Background="#FF6B00"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                Click="Connect"
                />
        </StackPanel>

          <Label
                Name="DeviceStatusText"
                Content=""
                Width="252"
                Height="29"
                Background="#0F1B29"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                />


        
        <StackPanel
            Orientation="Horizontal"
            Spacing="10"
            VerticalAlignment="Center">

            <ComboBox   
                Name="SourceComboBox"
                Grid.Row="1"
                Grid.Column="0"
                Width="141"
                Height="29"
                Background="#FF6B00"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                            />

            <Button
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Name="RunButton"
                Content="Start Run"
                Grid.Row="1"
                Grid.Column="1"
                Width="141"
                Height="29"
                Background="#FF6B00"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                Click="Run_Click"
                            />

        </StackPanel>
       <Label
                Name="RunStatusLabel"
                Width="252"
                Content=""
                Height="52"
                Background="#0F1B29"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                FontFamily="Sora"
                FontSize="16"
                BorderThickness="1">
            </Label>
        <Label
                Name="LostFramesLbl"
                Width="252"
                Content=""
                Height="52"
                Background="#0F1B29"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                FontFamily="Sora"
                FontSize="16"
                BorderThickness="1">
            </Label>
   


        </StackPanel>



        </Grid>


        <Grid 
        Grid.Column="1"
        Background="#223146"
        RowDefinitions="1*,3*,1*">

       <Label
                Grid.Row="0"
                Name="UsernameLabel"
                Content="User: "
                Width="252"
                Height="29"
                Background="#0F1B29"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                />
        
        <dg:DataGrid
                x:Name="DataGridLog"
                Grid.Row="1"
                AutoGenerateColumns="True"
                IsReadOnly="True"
                Width="600"
                Height="300"
                Background="White"
                />

           <Button
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Name="ExportData"
                Content="Export to csv"
                Grid.Row="2"
                Width="141"
                Height="29"
                Background="#FF6B00"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                Click="Export_Click"
                            />


        </Grid>

        </Grid>
        
</Window>
