<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="720"
        x:Class="PrimeraApp.VoltageWindow"
        Width="1280"

        Title="VoltageWindow">
     <Window.Styles>
        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="#0F1B29"/>
        </Style>

        <Style Selector="TextBox:focus /template/ Border">
            <Setter Property="Background" Value="#0F1B29"/>
        </Style>

    </Window.Styles>       
    <Grid 
        ShowGridLines="True"
        Background="#223146"
        ColumnDefinitions="*,*">

        <Grid 
            Grid.Column="0"
            ShowGridLines="True"
            Background="#223146"
            RowDefinitions="*,*">

        <Grid
            ShowGridLines="True"
            Background="#223146"
            Grid.Row="0"
            RowDefinitions="*,*">

        <Label
            Grid.Row="0"
                Name="VoltageLabel"
                Content="Live Voltage"
                HorizontalContentAlignment="Center"
                Width="252"
                Height="29"
                Background="#0F1B29"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                />
        <Grid
            ShowGridLines="True"
            Background="#223146"
            Grid.Row="1"
            RowDefinitions="*,*">


        <Label
                Grid.Row="0"
                Name="CurrentVoltageLabel"
                Width="252"
                Content="Current voltage: "
                HorizontalContentAlignment="Center"
                Height="52"
                Background="#0F1B29"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                FontFamily="Sora"
                FontSize="16"
                BorderThickness="1">
            </Label>

        <Label
                Grid.Row="1"
                Name="Voltage"
                Width="252"
                Content="5v"
                HorizontalContentAlignment="Center"
                Height="52"
                Background="#0F1B29"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                FontFamily="Sora"
                FontSize="16"
                BorderThickness="1">
            </Label>



        </Grid>

        </Grid>
        

        <Grid
            ShowGridLines="True"
            Background="#223146"
            Grid.Row="1"
            ColumnDefinitions="*,*"
            RowDefinitions="*,*">

        <ComboBox   
                
                Grid.Row="0"
                Grid.Column="0"
                Name="PortComboBox"
                Width="141"
                Height="29"
                Background="#FF6B00"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                            />

            <Button

                Name="ConectarButton"
                Grid.Row="0"
                Grid.Column="1"
                Content="Conectar"
                Width="141"
                Height="29"
                Background="#FF6B00"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                Click="Connect"
                            />
            
            <ComboBox   
                Name="SourceComboBox"
                Grid.Row="1"
                Grid.Column="0"
                Width="141"
                Height="29"
                Background="#FF6B00"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                            />

            <Button
                Name="RunButton"
                Content="Start Run"
                Grid.Row="1"
                Grid.Column="1"
                Width="141"
                Height="29"
                Background="#FF6B00"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                Click="Run_Click"
                            />

    

        </Grid>

        </Grid>






                                               <Button
                Name="HistorialButton"
                Content="Check Log"
                Width="141"
                Height="29"
                Background="#FF6B00"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                Click="MiBoton_Click"
                BorderThickness="1"
                            />
            

            <Label
                Name="RunStatusLabel"
                Width="252"
                Content=""
                Height="52"
                Background="#0F1B29"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                FontFamily="Sora"
                FontSize="16"
                BorderThickness="1">
            </Label>
   

             <Label
                Name="DeviceStatusText"
                Content=""
                Width="252"
                Height="29"
                Background="#0F1B29"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                />

                          <Label
                Name="UsernameLabel"
                Content="User: "
                Width="252"
                Height="29"
                Background="#0F1B29"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                />
 

        </Grid>
        
</Window>
