<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="720"
        x:Class="VoltageSystem.LoginWindow"
        Width="1280"

        Title="LoginWindow">
     <Window.Styles>

        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="#0F1B29"/>
        </Style>

        <Style Selector="TextBox:focus /template/ Border">
            <Setter Property="Background" Value="#0F1B29"/>
        </Style>

    </Window.Styles>       
        <Canvas
            Height="720"
            Background="#223146"
            Width="1280">
            <Button
                Name="LoginButton"
                Content="Log in"
                Width="252"
                Height="52"
                Canvas.Top="553"
                Canvas.Left="480"
                Background="#FF6B00"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                Click="MiBoton_Click"
                            />

            <TextBox
                Name="UserText"
                Width="252"
                Text=""
                Height="52"
                Canvas.Top="293"
                Canvas.Left="480"
                Background="#0F1B29"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                FontFamily="Sora"
                FontSize="16"
                BorderThickness="1">
            </TextBox>
                

             <TextBox
                Name="PasswordText"
                Text=""
                Width="252"
                Height="52"
                Canvas.Top="393"
                Canvas.Left="480"
                Background="#0F1B29"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                />

          <Label
                Name="UserLabel"
                Content="User"
                Width="252"
                Height="52"
                Canvas.Top="270"
                Canvas.Left="480"
                Foreground="#FFFFFF"
                />
 
          <Label
                Name="PasswordLabel"
                Content="Password"
                Width="252"
                Height="52"
                Canvas.Top="370"
                Canvas.Left="480"
                Foreground="#FFFFFF"
                />

         <Label
                Name="StatusLabel"
                Content=""
                Width="252"
                Height="52"
                Canvas.Top="450"
                Canvas.Left="480"
                Foreground="#FF0000"
                />




        </Canvas>
        
</Window>
