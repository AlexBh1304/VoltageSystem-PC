<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="720"
        x:Class="PrimeraApp.DatabaseWindow"
        Width="1280"

        Title="DatabaseWindow">
     <Window.Styles>

        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="#0F1B29"/>
        </Style>

        <Style Selector="TextBox:focus /template/ Border">
            <Setter Property="Background" Value="#0F1B29"/>
        </Style>

    </Window.Styles>       
        <Canvas
            Height="720"
            Background="#223146"
            Width="1280">
            <Button
                Name="BackButton"
                Content="Voltage Home"
                Width="252"
                Height="52"
                Canvas.Top="150"
                Canvas.Left="880"
                Background="#FF6B00"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                Click="MiBoton_Click"
                            />

               <Button
                Name="ExportarButton"
                Content="Exportar a csv"
                Width="141"
                Height="29"
                Canvas.Top="628"
                Canvas.Left="106"
                Background="#FF6B00"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                />

               <Button
                Name="CloseButton"
                Content="X"
                Width="30"
                Height="30"
                Canvas.Top="50"
                Canvas.Left="1220"
                Background="#FF6B00"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                Click="Closear"
                />

             <Label
                Name="HistoryLabel"
                Content="Historial de mediciones"
                Width="252"
                Height="29"
                Canvas.Top="100"
                Canvas.Left="50"
                Background="#0F1B29"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                />

              <Label
                Name="UsernameLabel"
                Content="User: "
                Width="252"
                Height="29"
                Canvas.Top="50"
                Canvas.Left="880"
                Background="#0F1B29"
                Foreground="#FFFFFF"
                BorderBrush="#FFFFFF"
                BorderThickness="1"
                />
 

        </Canvas>
        
</Window>
